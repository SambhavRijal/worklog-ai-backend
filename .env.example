# ---- WorkLog AI backend config ----
# Copy this file to ".env" and fill in the values.

# Port the backend listens on
PORT=8787

# ---- Database (Postgres) ----
# Any Postgres: local, Supabase, Neon, RDS… Use the DIRECT/session connection for a
# long-lived server, not a transaction pooler.
#   local:   postgres://user:pass@localhost:5432/worklog
#   managed: postgres://user:pass@host:5432/dbname
DATABASE_URL=postgres://postgres:postgres@localhost:5432/worklog

# Managed Postgres needs TLS; a local server usually doesn't. Set to "disable" for local.
# (localhost is auto-detected, so you rarely need this.)
# PGSSL=disable

# Public URL the browser can reach this backend at (no trailing slash). The OAuth
# redirect is "<PUBLIC_URL>/auth/slack/callback" and must match what you register in
# the Slack app EXACTLY. Must be the same URL the extension's BACKEND_URL points to.
PUBLIC_URL=http://localhost:8787

# ---- Slack OAuth (recommended: per-user sign-in) ----
# Each teammate signs in with Slack from the extension; the backend stores their
# own user token. Get these from your Slack app's "Basic Information" page.
SLACK_CLIENT_ID=your-client-id
SLACK_CLIENT_SECRET=your-client-secret

# The marker phrase that identifies your morning post.
# The backend searches Slack for your own message containing this phrase, today.
# Make it match how your team actually writes it.
START_MARKER=before you start work

# Optional label used when composing the finish-work message
FINISH_HEADER=Before you finish work

# Header for the check-in post. MUST contain START_MARKER, or check-out won't be
# able to find the post that check-in created.
START_HEADER=Before you start work

# Phrase identifying the daily workflow message everyone replies under. Posts are
# made as REPLIES in that thread, never as new channel messages. If your workflow
# post uses different wording, change this to match.
THREAD_ANCHOR=Please report in this thread

# ---- AI (OPTIONAL) ----
# Leave AI_ENABLED=false to run with zero AI (deterministic parsing, no analysis).
# Teammates without AI keys should keep this false — the tool works fully without it.
AI_ENABLED=false
ANTHROPIC_API_KEY=

# ---- Jira (optional, Phase 2) ----
# Atlassian OAuth 2.0 (3LO) app from https://developer.atlassian.com/console/myapps/
# Leave blank to disable Jira entirely — the extension hides the panel.
# Callback URL to register there: <PUBLIC_URL>/auth/jira/callback
# Scopes: read:jira-work, read:jira-user, offline_access
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# An Atlassian account can grant SEVERAL Jira sites (e.g. jobinsv1 and jobinsv2).
# Without this the first one wins, which silently queries the wrong Jira — valid
# queries, correct token, no results. Matched against the site name or URL.
# JIRA_SITE=jobinsv1

# Which sprint sub-task statuses each modal pulls. Comma-separated; must match your
# Jira's status names exactly. Defaults shown — override if your workflow differs.
# JIRA_CHECKIN_STATUSES=To Do,In Progress
# JIRA_CHECKOUT_STATUSES=In Progress,Review,In QA,Done,Live
